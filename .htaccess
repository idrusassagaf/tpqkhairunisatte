# =========================================================
# ROOT DOMAIN: melayani frontend (hasil build di dist/)
# =========================================================
# Auto deploy dari GitHub langsung menampilkan build terbaru.
# API tetap di subdomain api-backend.
# =========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Folder aset hasil build
    RewriteRule ^(assets|tinymce|images)/(.*)$ dist/$1/$2 [L]

    # File statis di root dist (logo, favicon, mp4, dll.)
    RewriteRule ^([^/]+\.(png|jpg|jpeg|gif|svg|ico|webp|mp3|mp4|ttf|woff|woff2|json|txt|xml|webmanifest|css|js))$ dist/$1 [L]

    # Selain itu (termasuk route React seperti /dashboard dan root /): index.html
    # Hanya jika file yang diminta memang tidak ada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ dist/index.html [L]
</IfModule>
